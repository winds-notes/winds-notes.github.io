# Copy values into the hosting provider's private settings, or a gitignored
# .env.production beside compose.yaml. Do not put actual secrets in this file.
WINDS_PUBLIC_ORIGIN=https://notes.example.com
GOOGLE_CLIENT_ID=your-public-google-web-client-id
GOOGLE_CLIENT_SECRET=your-private-google-oauth-client-secret
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WINDS_SESSION_KEY=replace-with-a-generated-32-byte-base64-key
WINDS_SESSION_FILE=/data/sessions.enc
WINDS_LIVE_SYNC=true

# Optional PUBLIC browser key for shared-notebook authorization. Enable Google Picker API.
WINDS_GOOGLE_PICKER_API_KEY=
